# Chỉ dành cho job cập nhật SSI; dashboard không đọc credentials.
SSI_API_KEY=
SSI_API_SECRET=

# Không bắt buộc theo Config của SDK; để trống nếu tài khoản không được cấp.
SSI_CLIENT_ID=

# Tùy chọn. Mặc định: data/
LIQUISENSE_DATA_DIR=data

# Tùy chọn. Số request mỗi giây gửi tới SSI (mặc định 5). Giảm xuống nếu hay bị chặn.
LIQUISENSE_RATE_LIMIT=5

# Tùy chọn. Số năm lịch sử tải cho mã mới (mặc định 1). Muốn tải bù cho mã đã có: update.py --so-nam N
LIQUISENSE_HISTORY_YEARS=1
